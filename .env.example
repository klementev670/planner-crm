# Supabase (Settings → API в панели проекта)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# Придумай код доступа для входа в приложение
APP_PASSCODE=1234

# Веб-пуш (сгенерировать: npm run generate-vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Секрет для защиты /api/cron/deadlines (любая случайная строка)
CRON_SECRET=change-me
